DB_URL=postgresql+psycopg://workflow:workflow@localhost:5432/ai_workflows
CHECKPOINT_DB_URL=postgresql://workflow:workflow@localhost:5432/ai_workflows

# Enterprise LLM: GitHub Copilot (SSO-compatible via GitHub org/Enterprise SSO)
LLM_PROVIDER=github_copilot
COPILOT_MODEL=gpt-4o
COPILOT_BASE_URL=https://api.githubcopilot.com
# Pre-authorized GitHub OAuth token (SSO-authorized for the org). If unset, run
# the device flow once: GitHubCopilotTokenProvider().login_device_flow().
GH_COPILOT_OAUTH_TOKEN=

ARTIFACT_DIR=./artifacts
