DB_URL=postgresql+psycopg://workflow:workflow@localhost:5432/ai_workflows
CHECKPOINT_DB_URL=postgresql://workflow:workflow@localhost:5432/ai_workflows

# Enterprise LLM: GitHub Copilot (SSO-compatible via GitHub org/Enterprise SSO)
LLM_PROVIDER=github_copilot
# Default agent model. Variants: chatgpt-5.6-sol / -terra / -luna
COPILOT_MODEL=chatgpt-5.6-terra
COPILOT_BASE_URL=https://api.githubcopilot.com
# Per-agent model overrides for the dev orchestrator (any role not listed uses
# COPILOT_MODEL). Parsed via config.parse_agent_models().
# COPILOT_AGENT_MODELS=implement=chatgpt-5.6-sol,review_solid=chatgpt-5.6-luna,reflect=chatgpt-5.6-sol
# Pre-authorized GitHub OAuth token (SSO-authorized for the org). If unset, run
# the device flow once: GitHubCopilotTokenProvider().login_device_flow().
GH_COPILOT_OAUTH_TOKEN=

# Context compression / cache (dev orchestrator). See docs/headroom_integration.md
# COMPRESSOR=headroom              # none | headroom (SDK mode)
# HEADROOM_PROXY_URL=http://localhost:8080   # proxy mode: route Copilot via Headroom
# LLM_CACHE=memory                 # none | memory | sqlite (dedupe identical calls)

ARTIFACT_DIR=./artifacts
